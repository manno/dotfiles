# Copy to .envrc and fill in values, then run: direnv allow
#
# GITHUB_TOKEN is used for:
#   - GitHub Releases API (bump-nvim-plugins.go)
#   - gh CLI calls inside analyze-plugin.mjs (diffs, file content, commits)
#
# A classic PAT with no scopes is enough for public repos.
# For private repos add: repo (read)

export GITHUB_TOKEN=ghp_your_token_here

# ZAI_API_KEY is used for:
#   - z.ai GLM API / glm-4.7 (analyze-plugin.mjs)
#
# Create a key at https://z.ai/manage-apikey/apikey-list
# In CI this comes from the ZAI_API_KEY repository secret.

export ZAI_API_KEY=your_zai_key_here
